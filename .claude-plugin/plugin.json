{
  "name": "prompt-clarify",
  "displayName": "Prompt Clarify",
  "version": "0.3.0",
  "description": "Rewrite a rough request into a clearer prompt and put it back in the prompt box, unsent (/clarify or a trailing --clarify)",
  "author": { "name": "luchasarie", "url": "https://github.com/luchasarie" },
  "homepage": "https://github.com/luchasarie/claude-clarify",
  "repository": "https://github.com/luchasarie/claude-clarify",
  "supportUrl": "https://github.com/luchasarie/claude-clarify/issues",
  "privacyPolicyUrl": "https://github.com/luchasarie/claude-clarify/blob/main/PRIVACY.md",
  "license": "MIT",
  "keywords": ["prompt", "rewrite", "clarify", "prompt-engineering", "composer"],
  "userConfig": {
    "model": {
      "type": "string",
      "title": "Clarify model",
      "description": "Model that rewrites the request",
      "default": "sonnet",
      "options": ["haiku", "sonnet", "opus"]
    }
  }
}
